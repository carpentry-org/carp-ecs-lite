(load "../src/ecs.carp")
(load "../../carp-sparseset/sparse_set.carp")

(use ECS)

(deftype Position [x Float
                   y Float])
(defmodule Position
  (defn zero [] (Position.init 0f 0f))
  (implements zero Position.zero)
  (defn str [p]
    (str* "Pos("
          (Float.str @(Position.x p))
          ", "
          (Float.str @(Position.y p))
          ")"))
  (implements str Position.str))

(deftype Velocity [dx Float
                   dy Float])
(defmodule Velocity
  (defn zero [] (Velocity.init 0f 0f))
  (implements zero Velocity.zero))

;; The Big Moment!
(ECS.defworld GameWorld Position Velocity)

(defn main []
  (let [world (GameWorld.new)
        e1 (GameWorld.create-entity! &world)
        e2 (GameWorld.create-entity! &world)]
    (do
      (IO.println "Full defworld test...")

      (ECS.add-component! &world &e1 (Position.init 10f 20f))
      (ECS.add-component! &world &e1 (Velocity.init 1f 1f))
      (ECS.add-component! &world &e2 (Position.init 100f 200f))

      (match (the (Maybe Position) (ECS.get-component &world &e1))
        (Maybe.Just p) (IO.println &(str* "E1 Position: " (str &p)))
        (Maybe.Nothing) (IO.println "E1 Position not found!"))

      (ECS.query &world
                 (e (pos Position) (vel Velocity))
                 (do
                   (IO.println &(str* "Moving entity " (str &e)))
                   (ECS.add-component! &world
                                       &e
                                       (Position.init (+ @(Position.x pos)
                                                         @(Velocity.dx vel))
                                                      (+ @(Position.y pos)
                                                         @(Velocity.dy vel))))))

      (let [p1 (Maybe.unsafe-from
              (the (Maybe Position) (ECS.get-component &world &e1)))]
        (do
          (IO.println &(str* "E1 pos after move: " (str &p1)))
          (assert (= @(Position.x &p1) 11f))))

      (IO.println "ECS defworld test passed!")
      0)))
